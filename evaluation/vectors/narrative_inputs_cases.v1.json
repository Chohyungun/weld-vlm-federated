 "world_pairs_meta_meaning": "합성 세계의 PAIRS_META(2 판 · 1 판) — 시험이 지은 메타가 이 객체와 같아야 한다. I-02 공동 사례(joint_i02)는 `pairs_meta` 에 메타 객체를 그대로 싣는다 — 생성 쪽 시험 20 이 같은 입력을 쓴다",
 "stages": [
  "① contract_sha — 학습 등록이 묶은 sha256 ≠ 계약 바이트면 여기서 멈춘다",
  "② 계약의 꼴 — contract_form · conditions · 꼴로 보이는 hash_rule(규칙 이름 · 묶음 sha 가 제 파일 하나의 sha)이 있으면 멈춘다",
  "③ 실제 바이트 — code_bytes · 값으로 보이는 hash_rule(원시 칸에 LF sha)이 있으면 멈춘다",
  "④ 호출자가 검증한 사실 — pairs_unverified · pairs_digest · pairs_meta_bytes(멈추지 않고 ⑤ 로)",
  "⑤ PAIRS_META 신원 — pairs_meta_identity"
 ],
 "v6_stages": [
  "① 판 6 의 꼴 — v6_form(판 6 이 아니다 · 블록이 없다 · 계약 sha 칸이 비었다)이면 멈춘다",
  "② 넘긴 계약의 꼴 — contract_form · conditions · hash_rule 이면 멈춘다",
  "③ 학습 PIN — pin_bytes(어댑터 meta 의 start_gate.pin_sha256 과 바이트) · pin_contract(PIN 의 계약 sha)",
  "④ 판 6 의 계약 sha — v6_contract_sha",
  "⑤ 판 6 의 신원 칸 ↔ 계약 — v6_identity · 꼴이 섞이면 hash_rule"
 ],
 "ops_meaning": {
  "set": "경로의 값을 바꾼다 — value 또는 from({text_sha: 글 열쇠} · {lf_sha: 파일} · {raw_sha: 파일})",
  "del": "경로의 칸을 지운다",
  "copy": "한 경로의 값을 다른 경로에 통째로 옮긴다",
  "reverse": "목록을 뒤집는다",
  "duplicate_first": "목록의 첫 원소를 하나 더 붙인다(정렬은 그대로)",
  "upper": "문자열을 대문자로",
  "drop_first_file": "묶음 블록의 첫 파일을 빼고 그 블록의 sha 를 남은 목록으로 다시 낸다",
  "contract_table · meta_table": "계약 · PAIRS_META 의 표 경로를 다른 판으로(값은 그 파일에서 잰다)",
  "keep_registered": "학습 등록의 sha 는 ops 앞 계약의 값 그대로(옛 영수증)",
  "verified_from_variant": "호출자의 검증 사실을 1 판 페어(경로 · digest · 1 판 메타)로",
  "meta_variant": "PAIRS_META 를 1 판 꼴(신원 블록 · 문장 계약 칸 없음)으로",
  "contract_noncanonical": "계약을 정규형이 아닌 바이트(들여쓰기 다름)로 쓴다",
  "swap_contract": "학습 PIN 은 처음 계약으로 짓고, 파일을 바꾼 뒤 다시 지은 계약 · 판 6 을 함께 넘긴다",
  "adapters": "어댑터 meta 다섯 칸의 start_gate.pin_sha256 — 기본은 PIN 바이트의 sha, other = 다른 값, empty = 빈 목록"
